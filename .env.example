NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://zetro.online

# Optional. If unset, invites use Supabase Auth invite emails.
# For people who already have an account, set Resend so they still get a join link.
RESEND_API_KEY=
RESEND_FROM=Zetro <noreply@yourdomain.com>

ASSEMBLYAI_API_KEY=your-assemblyai-key
OPENAI_API_KEY=your-openai-key
OPENAI_PROJECT=

LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
AI_REASONING_MODEL=gpt-5
AI_FAST_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.1
AI_MAX_RETRIES=3
AI_TIMEOUT=120000
