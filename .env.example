NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: after workspaces are live, run supabase/country.sql for country-based languages.
# East Africa (TZ/KE/UG/…) = Kiswahili + English. Other countries = English only.
# Also run supabase/sales-requests.sql and supabase/invite-expiry.sql when missing.

# Required for welcome emails and workspace invites. Verify zetro.online at
# https://resend.com/domains or Resend will only deliver to the email on your Resend account.
RESEND_API_KEY=
RESEND_FROM=Zetro <noreply@zetro.online>

ASSEMBLYAI_API_KEY=your-assemblyai-key
OPENAI_API_KEY=your-openai-key
OPENAI_PROJECT=

LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
# Override in production if you use a stronger scoring model.
AI_REASONING_MODEL=gpt-4o-mini
AI_FAST_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.1
AI_MAX_RETRIES=3
AI_TIMEOUT=120000
